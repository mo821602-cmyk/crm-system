# AI Configuration
AI_ENABLED=true
AI_MODEL_PATH=./models
AI_TRAINING_EPOCHS=100
AI_LEARNING_RATE=0.01
AI_BATCH_SIZE=32

# NLP Configuration
NLP_LANGUAGE=en
NLP_SENTIMENT_ENABLED=true
NLP_EXTRACTION_ENABLED=true
NLP_CLASSIFICATION_ENABLED=true

# Machine Learning
ML_PREDICTION_THRESHOLD=0.7
ML_CLUSTERING_K=5
ML_ANOMALY_THRESHOLD=2.5
ML_CROSS_VALIDATION_FOLDS=5

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_business_management
DB_USER=admin
DB_PASSWORD=strong_password

# Server
PORT=3003
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRY=7d

# Model Updates
AUTO_TRAIN=true
TRAINING_SCHEDULE=0 2 * * * # 2 AM daily
MODEL_EVALUATION_INTERVAL=7 # days

# Logging
LOG_LEVEL=info
LOG_FILE=logs/ai-business.log
